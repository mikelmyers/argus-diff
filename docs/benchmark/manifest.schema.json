{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argus trust benchmark manifest",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "source", "provenance", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "tier": {"enum": ["calibration", "public_labeled", "private_consented"]},
          "source": {"type": "object"},
          "provenance": {
            "type": "object",
            "required": ["license", "permission", "reviewed_by"]
          },
          "expected": {
            "type": "object",
            "required": ["counts", "pairs"]
          }
        }
      }
    }
  }
}
